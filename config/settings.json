{
  "channel_name": "日本が誇る皇室物語",
  "output": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "vcodec": "libx264",
    "crf": 18,
    "preset": "medium",
    "acodec": "aac",
    "audio_bitrate": "192k",
    "max_duration": 60.0,
    "target_loudness_lufs": -16.0
  },
  "tts": {
    "engine_order": [
      "voicevox",
      "voicevox_core",
      "openjtalk"
    ],
    "voicevox_url": "http://127.0.0.1:50021",
