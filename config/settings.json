      "CC BY",
      "CC BY-SA",
      "Attribution"
    ],
    "blocked_license_keywords": [
      "NC",
      "ND",
      "Fair use",
      "Non-free"
    ],
    "min_long_side": 700,
    "max_per_scene_candidates": 6
  }
