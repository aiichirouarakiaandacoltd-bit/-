  "research": {
    "lookback_days": 21,
    "max_candidates": 30,
    "llm_backend_order": [
      "claude_cli",
      "anthropic_api"
    ],
    "claude_cli_model": "",
    "anthropic_model": "claude-opus-5-5"
  },
  "assets": {
